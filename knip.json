{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main/simple-main.js",
    "src/preload/preload.js",
    "src/renderer/index.js",
    "src/renderer/App.js",
    "src/renderer/components/PhaseRenderer.jsx",
    "src/renderer/components/SettingsPanel.jsx",
    "src/renderer/components/AnalysisHistoryModal.jsx",
    "src/renderer/components/search/UnifiedSearchModal.jsx",
    "src/renderer/phases/WelcomePhase.jsx",
    "src/renderer/phases/SetupPhase.jsx",
    "src/renderer/phases/DiscoverPhase.jsx",
    "src/renderer/phases/OrganizePhase.jsx",
    "src/renderer/phases/CompletePhase.jsx",
    "src/main/workers/*.js",
    "scripts/*.js",
    "scripts/**/*.js",
    "test/**/*.test.{js,ts}",
    "test/**/*.spec.{js,ts}",
    "webpack.config.js",
    "webpack.main.config.js",
    "babel.config.js",
    "postcss.config.js",
    "playwright.config.js",
    "eslint.config.js"
  ],
  "project": [
    "src/**/*.{js,jsx,ts,tsx}",
    "scripts/**/*.js",
    "test/**/*.{js,ts,jsx,tsx}"
  ],
  "ignore": [
    "**/*.d.ts",
    "**/dist/**",
    "**/release/**",
    "**/node_modules/**",
    "**/.tmp/**",
    "**/.legacy/**",
    "test/test-files/**",
    "test/fixtures/**",
    "test/jest.config.js",
    "test/stress/jest.config.js",
    "test/stress/setup.js",
    "test/test-globals.js",
    "test/test-setup.js",
    "test/mocks/**",
    "docs/**",
    "src/shared/securityConfigPathLimits.preload-stub.js",
    "src/renderer/components/dashboard/DashboardView.jsx",
    "src/renderer/components/setup/AddSmartFolderModal.jsx",
    "src/renderer/components/setup/SmartFolderItem.jsx"
  ],
  "ignoreDependencies": [
    "@babel/plugin-transform-react-jsx",
    "@babel/preset-typescript",
    "@electron/notarize",
    "@types/.*",
    "assert",
    "buffer",
    "core-js",
    "cssnano",
    "process",
    "tsconfig-paths-webpack-plugin",
    "url",
    "util",
    "webpack-merge",
    "stream-browserify",
    "path-browserify",
    "os-browserify",
    "querystring-es3",
    "memfs",
    "html-webpack-plugin",
    "@pmmmwh/react-refresh-webpack-plugin",
    "react-refresh",
    "babel-loader",
    "css-loader",
    "style-loader",
    "mini-css-extract-plugin",
    "postcss-loader",
    "terser-webpack-plugin",
    "webpack-bundle-analyzer",
    "@svgr/webpack",
    "@tailwindcss/postcss",
    "electron-devtools-installer",
    "globals",
    "jest-environment-jsdom",
    "pino-pretty",
    "png-to-ico",
    "rimraf"
  ],
  "ignoreBinaries": ["npm-check-updates"]
}
